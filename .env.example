# AgentWall Configuration

# LLM Provider: "gemini" (default) or "featherless"
LLM_PROVIDER=gemini

# Google Gemini API (Free tier key from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Featherless AI Fallback Provider (Optional)
FEATHERLESS_API_KEY=your_featherless_api_key_here
FEATHERLESS_MODEL=Qwen/Qwen2.5-72B-Instruct

# Execution Mode: "replay" (deterministic offline demo) or "live"
AGENTWALL_MODE=replay
