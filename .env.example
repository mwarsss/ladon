# Ladon configuration. Copy to .env and fill in only what you need.
# With nothing set, the scenario dashboard (replay) and the Attack Lab's
# "fully fooled" assistant still work fully offline.

# Model provider for live mode: "gemini" or "featherless"
LLM_PROVIDER=gemini

# Google Gemini (free key from Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Featherless AI (open models; ForgeHacks participants get credits)
FEATHERLESS_API_KEY=
FEATHERLESS_MODEL=Qwen/Qwen2.5-72B-Instruct

# Optional: a real inbox for the Attack Lab (agentboxd.com)
AGENTBOXD_API_KEY=
AGENTBOXD_INBOX_ID=
AGENTBOXD_INBOX_ADDRESS=

# Attack Lab limits (protect your model credits on a public deployment)
LAB_LIVE=1
LAB_LIVE_RUNS_PER_DAY=40
LAB_RUNS_PER_IP_PER_HOUR=6
LAB_INBOX_CHECKS_PER_HOUR=600
DASHBOARD_ACTIONS_PER_HOUR=60

# Public deployment hardening: no API docs, replay-only dashboard, HSTS, generic model errors
LADON_PUBLIC=0
# How to find the visitor's IP for rate limits:
#   cloudflare - CF-Connecting-IP (Render); 1 - first X-Forwarded-For entry (only behind a proxy
#   you control that strips client-sent values); 0 - the socket address (local runs)
TRUST_PROXY=0
